[TEMPLATE]
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-this-to-something-long-and-random

# Recur uses Ollama Local by default. No API key is required.
PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_QUICK=smollm2:135m-instruct-q8_0
MODEL_DEFAULT=qwen2.5:0.5b
MODEL_COMPLEX=llama3.1:8b-instruct-q4_K_M

# Hosted providers are intentionally configured through the Integrations page,
# where each account key is encrypted and selected explicitly.
