[TEMPLATE]
# Copy to server/.env and edit. Only JWT_SECRET really needs a value for a
# fresh local run; everything else is a default that already works.

# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Encrypts provider keys saved on the Integrations page. Falls back to
# JWT_SECRET when empty. Changing it makes previously saved keys unreadable.
INTEGRATION_ENCRYPTION_KEY=

# Browser origin allowed by CORS and used to build OAuth callbacks. In
# production this must be the deployed URL, for example
# https://recur.vercel.app, or every request from the deployed app is blocked.
CLIENT_ORIGIN=http://localhost:5173

# Port for local runs. Hosting platforms set this themselves.
PORT=8787

# Where the Ollama daemon lives. On hosting this has to be a tunnel to your own
# machine, because compiled programs run without a model but general answers do
# not.
PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model for each of the three tiers.
MODEL_QUICK=smollm2:135m-instruct-q8_0
MODEL_DEFAULT=qwen2.5:0.5b
MODEL_COMPLEX=llama3.1:8b-instruct-q4_K_M

# Hosted providers are intentionally not configured here. They are added on the
# Integrations page, where each account key is encrypted and selected explicitly.
