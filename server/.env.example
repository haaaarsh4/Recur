PORT=8787
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-this-to-something-long-and-random

# "openai" or "anthropic", whichever key you have.
PROVIDER=openai
API_KEY=sk-put-your-key-here

# Optional setting to override which model each speed tier uses.
# Defaults below are used if you leave these unset.
#
# OpenAI:
MODEL_QUICK=gpt-4o-mini
MODEL_DEFAULT=gpt-4o-mini
MODEL_COMPLEX=gpt-4o
#
# Anthropic (if PROVIDER=anthropic):
# MODEL_QUICK=claude-haiku-4-5-20251001
# MODEL_DEFAULT=claude-sonnet-4-6
# MODEL_COMPLEX=claude-opus-4-5
