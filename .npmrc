# Render sets NODE_ENV=production, which makes npm skip devDependencies.
# vite (a devDependency) is required at build time, so the deploy failed with
# "vite: not found". The root "setup" script in package.json passes explicit
# install flags to guarantee devDependencies are always present. These settings
# add a second layer of protection for direct npm installs.
omit=
include=dev
